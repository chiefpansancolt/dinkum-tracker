    },
    "bugs": {
        "url": "https://github.com/chiefpansancolt/dinkum-tracker/issues"
    },
    "keywords": [
        "dinkum",
        "tracker",
        "game",
        "nextjs",
        "react"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
