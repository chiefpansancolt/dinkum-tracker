{
    "name": "dinkum-tracker",
    "version": "2.0.0",
    "description": "A progress tracker for the game Dinkum — manage playthroughs, track collections, milestones, licenses, and more.",
    "private": true,
    "author": "chiefpansancolt",
    "homepage": "https://dinkum.gamerdex.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/GamerdexApp/dinkum-tracker.git"
    },
    "bugs": {
        "url": "https://github.com/GamerdexApp/dinkum-tracker/issues"
    },
    "keywords": [
        "dinkum",
        "tracker",
        "game",
        "nextjs",
        "react"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "vitest run",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "postinstall": "bash scripts/copy-game-assets.sh"
    },
    "dependencies": {
        "@gamerdexapp/gamerdex-sync": "0.5.0",
        "dinkum-data": "1.0.3",
        "next": "16.4.2",
        "next-intl": "^4.14.9",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.2",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react-icons": "^5.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
