    "description": "A progress tracker for the game Dinkum — manage playthroughs, track collections, milestones, licenses, and more.",
    "private": true,
    "author": "chiefpansancolt",
    "homepage": "https://dinkum.gamerdex.app",
    "repository": {
        "type": "git",
