    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.3.5",
        "prettier": "^3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react-icons": "^5.7.0",
        "tailwindcss": "^4.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    }
